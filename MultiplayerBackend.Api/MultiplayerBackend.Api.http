###############################################################################
# Authentication
###############################################################################

### Register account
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "username": "sett",
  "password": "test-password-123",
  "playerName": "Sett"
}

### Login - correct password
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "username": "sett",
  "password": "test-password-123"
}

### Login - wrong password
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "username": "sett",
  "password": "wrong-password"
}

### Login Alice - correct password
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "username": "alice",
  "password": "test-password-123"
}

### Join login queue
POST {{host}}/api/login-queue/join
Authorization: Bearer {{settToken}}

### Alice joins queue
POST {{host}}/api/login-queue/join
Authorization: Bearer {{aliceToken}}

### Queue status Sett
GET {{host}}/api/login-queue/status
Authorization: Bearer {{settToken}}

### Queue status Alice
GET {{host}}/api/login-queue/status
Authorization: Bearer {{aliceToken}}

### Leave queue Sett
DELETE {{host}}/api/login-queue/leave
Authorization: Bearer {{settToken}}

### My profile
GET {{host}}/api/players/me
Authorization: Bearer {{settToken}}

### My inventory
GET {{host}}/api/players/me/inventory
Authorization: Bearer {{settToken}}

### Add item to my inventory
POST {{host}}/api/players/me/inventory
Authorization: Bearer {{settToken}}
Content-Type: application/json

{
  "itemName": "Health Potion",
  "amount": 10
}